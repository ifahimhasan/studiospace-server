# Port for local development
PORT=5000

# MongoDB Atlas connection string (same database the Next.js client uses for BetterAuth)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Public URL of the Next.js client. Used for CORS and to verify BetterAuth JWTs
# against the client's JWKS endpoint (CLIENT_URL/api/auth/jwks).
CLIENT_URL=http://localhost:3000

# Lifetime of the HTTPOnly JWT cookie, in days
COOKIE_DAYS=7

NODE_ENV=development
